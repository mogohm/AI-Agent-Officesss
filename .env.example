# =====================================================================
# AI Agent Office â€” root environment template
# Copy to .env (backend) and apps/web/.env.local (frontend) as noted.
# =====================================================================

# --- Backend (server/) ----------------------------------------------
# Dev default is SQLite (zero setup). For production use PostgreSQL:
#   postgresql+psycopg://ai_office:ai_office@localhost:5432/ai_office
DATABASE_URL=sqlite:///./ai_office.db

# Comma-separated web origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where project workspaces are created on the VPS.
WORKSPACES_ROOT=./workspaces/companies

# Seed demo data automatically on first run.
AUTO_SEED=true

# Optional Redis for future worker queue.
REDIS_URL=

# --- Future AI providers (leave blank while using the mock engine) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Frontend (apps/web/.env.local) ---------------------------------
# Base URL of the FastAPI backend (used by the browser).
NEXT_PUBLIC_API_URL=http://localhost:8000
