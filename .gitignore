# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.db
*.sqlite3

# Node / Next
node_modules/
.next/
out/
dist/

# Env
.env
.env.local
.env.*.local

# OS / IDE
.DS_Store
.vscode/
.idea/

# Generated workspaces (keep the folder, ignore contents)
workspaces/companies/*
!workspaces/companies/.gitkeep

# Creative worker artifacts (keep folders, ignore heavy binaries; text reports stay tracked)
outputs/*
!outputs/reports/
!outputs/**/.gitkeep
references/*
!references/.gitkeep
!references/README.md
# Keep approved permanent identity masters + the locked style references tracked
!references/approved-characters/
!references/approved-characters/**
!references/style-lock/
!references/style-lock/**
!references/ai-agent-office-reference.png

# Build caches
*.tsbuildinfo

# Logs
*.log
