// AI Agent Office — Prisma schema (PostgreSQL).
// Source of truth for the application. Money = Decimal, soft-delete = archivedAt,
// runtime vs business status kept separate, join tables (no id-array columns).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & users
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPER_ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  globalRole    GlobalRole @default(USER)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships     CompanyMember[]
  accounts        Account[]
  sessions        Session[]
  createdProjects Project[]        @relation("ProjectCreatedBy")
  createdTasks    AgentTask[]      @relation("TaskCreatedBy")
  approvalsMade   Approval[]       @relation("ApprovalDecidedBy")
  approvalsAssigned Approval[]     @relation("ApprovalAssignedTo")
  activityLogs    ActivityLog[]
  documents       KnowledgeDocument[]

  // --- autonomous delivery ---
  deliveryRoles     DeliveryMember[]
  missionsCreated   Mission[]           @relation("MissionCreatedBy")
  missionAuditLogs  MissionAuditLog[]
  defectsAssigned   Defect[]            @relation("DefectAssignedTo")
  defectComments    DefectComment[]
  releaseApprovals  ReleaseCandidate[]  @relation("ReleaseApprovedBy")
}

// Auth.js (NextAuth v5) adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

enum CompanyRole {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  REVIEWER
  VIEWER
}

model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Company {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  legalName    String?
  description  String?
  logoUrl      String?
  themeKey     String        @default("navy")
  timezone     String        @default("UTC")
  currency     String        @default("USD")
  status       CompanyStatus @default(ACTIVE)
  monthlyBudget Decimal?     @db.Decimal(12, 2)
  // Records created by automated tests. Hidden from normal UI queries by
  // default; never auto-deleted (tests clean up after themselves).
  isTestData   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?

  members             CompanyMember[]
  departments         Department[]
  workers             AIWorker[]
  projects            Project[]
  tasks               AgentTask[]
  approvals           Approval[]
  providerConnections ProviderConnection[]
  usageRecords        UsageRecord[]
  activityLogs        ActivityLog[]
  documents           KnowledgeDocument[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Department
// ---------------------------------------------------------------------------

enum DepartmentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum FloorType {
  OFFICE
  DEVELOPMENT
  CREATIVE
  MARKETING
  SALES
  MANAGEMENT
  MEETING
  SUPPORT
  SERVER
  CUSTOM
}

model Department {
  id                String           @id @default(cuid())
  companyId         String
  name              String
  slug              String
  description       String?
  floorOrder        Int
  floorType         FloorType        @default(OFFICE)
  status            DepartmentStatus @default(ACTIVE)
  defaultProviderId String?
  defaultModelId    String?
  monthlyBudget     Decimal?         @db.Decimal(12, 2)
  systemInstruction String?          @db.Text
  themeColor        String           @default("#3E70C9")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  archivedAt        DateTime?

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultProvider ProviderConnection? @relation(fields: [defaultProviderId], references: [id])
  workers        AIWorker[]
  tasks          AgentTask[]
  projectLinks   ProjectDepartment[]
  usageRecords   UsageRecord[]
  documents      KnowledgeDocument[]

  @@unique([companyId, slug])
  @@unique([companyId, floorOrder])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// AI Worker
// ---------------------------------------------------------------------------

enum WorkerStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkerRuntimeStatus {
  OFFLINE
  IDLE
  QUEUED
  THINKING
  WORKING
  WAITING_APPROVAL
  COMPLETED
  ERROR
}

model AIWorker {
  id                     String              @id @default(cuid())
  companyId              String
  departmentId           String?
  name                   String
  slug                   String
  role                   String              @default("Developer")
  description            String?
  avatarKey              String              @default("dev-a")
  providerConnectionId   String?
  modelId                String?
  systemPrompt           String?             @db.Text
  skills                 String[]
  toolPermissions        String[]
  status                 WorkerStatus        @default(ACTIVE)
  runtimeStatus          WorkerRuntimeStatus @default(OFFLINE)
  monthlyBudget          Decimal?            @db.Decimal(12, 2)
  currentMonthCost       Decimal             @default(0) @db.Decimal(12, 4)
  temperature            Float               @default(0.7)
  maxOutputTokens        Int                 @default(4096)
  maxExecutionSeconds    Int                 @default(120)
  requiresDefaultApproval Boolean            @default(false)
  seatX                  Int                 @default(0)
  seatY                  Int                 @default(0)
  lastActiveAt           DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  archivedAt             DateTime?

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  providerConnection ProviderConnection? @relation(fields: [providerConnectionId], references: [id])
  tasks              AgentTask[]
  taskRuns           TaskRun[]
  projectLinks       ProjectWorker[]
  usageRecords       UsageRecord[]
  approvalsRequested Approval[]          @relation("ApprovalRequestedBy")
  activityLogs       ActivityLog[]
  heartbeats         WorkerHeartbeat[]

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Project {
  id            String          @id @default(cuid())
  companyId     String
  name          String
  slug          String
  description   String?
  status        ProjectStatus   @default(DRAFT)
  priority      ProjectPriority @default(MEDIUM)
  startDate     DateTime?
  targetDate    DateTime?
  completedAt   DateTime?
  monthlyBudget Decimal?        @db.Decimal(12, 2)
  progress      Int             @default(0)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User?               @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  departmentLinks ProjectDepartment[]
  workerLinks     ProjectWorker[]
  tasks           AgentTask[]
  usageRecords    UsageRecord[]
  documents       KnowledgeDocument[]

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([companyId, priority])
}

model ProjectDepartment {
  projectId    String
  departmentId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([projectId, departmentId])
}

model ProjectWorker {
  projectId String
  workerId  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker    AIWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([projectId, workerId])
}

// ---------------------------------------------------------------------------
// Task & runs
// ---------------------------------------------------------------------------

enum TaskStatus {
  DRAFT
  QUEUED
  RUNNING
  WAITING_APPROVAL
  REVISION_REQUIRED
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model AgentTask {
  id                 String       @id @default(cuid())
  companyId          String
  projectId          String?
  departmentId       String?
  workerId           String?
  parentTaskId       String?
  title              String
  instruction        String       @db.Text
  status             TaskStatus   @default(DRAFT)
  priority           TaskPriority @default(NORMAL)
  inputJson          Json?
  outputJson         Json?
  errorJson          Json?
  providerOverrideId String?
  modelOverride      String?
  requiresApproval   Boolean      @default(false)
  createdById        String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  retryCount         Int          @default(0)
  maxRetries         Int          @default(2)
  timeoutSeconds     Int          @default(120)
  estimatedCost      Decimal      @default(0) @db.Decimal(12, 4)
  actualCost         Decimal      @default(0) @db.Decimal(12, 4)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  worker       AIWorker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  createdBy    User?       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  parentTask   AgentTask?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks     AgentTask[] @relation("TaskSubtasks")
  runs         TaskRun[]
  approvals    Approval[]
  usageRecords UsageRecord[]

  @@index([companyId, status])
  @@index([workerId])
  @@index([projectId])
}

enum TaskRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

model TaskRun {
  id                   String        @id @default(cuid())
  taskId               String
  attemptNumber        Int
  workerId             String?
  providerConnectionId String?
  model                String?
  status               TaskRunStatus @default(QUEUED)
  requestPayload       Json?
  responsePayload      Json?
  errorPayload         Json?
  promptTokens         Int           @default(0)
  completionTokens     Int           @default(0)
  totalTokens          Int           @default(0)
  estimatedCost        Decimal       @default(0) @db.Decimal(12, 4)
  actualCost           Decimal       @default(0) @db.Decimal(12, 4)
  queuedAt             DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  durationMs           Int?
  createdAt            DateTime      @default(now())

  task               AgentTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker             AIWorker?           @relation(fields: [workerId], references: [id], onDelete: SetNull)
  providerConnection ProviderConnection? @relation(fields: [providerConnectionId], references: [id])
  approvals          Approval[]
  usageRecords       UsageRecord[]

  @@unique([taskId, attemptNumber])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Approval
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalType {
  TASK_OUTPUT
  SEND_EMAIL
  PUBLISH_CONTENT
  MODIFY_FILE
  DELETE_FILE
  DEPLOY_APPLICATION
  EXECUTE_EXTERNAL_ACTION
  SPEND_LIMIT
  CUSTOM
}

model Approval {
  id                  String         @id @default(cuid())
  companyId           String
  taskId              String
  taskRunId           String?
  type                ApprovalType   @default(TASK_OUTPUT)
  status              ApprovalStatus @default(PENDING)
  requestedByWorkerId String?
  assignedToUserId    String?
  summary             String
  payload             Json?
  decisionNote        String?        @db.Text
  decidedByUserId     String?
  requestedAt         DateTime       @default(now())
  decidedAt           DateTime?
  expiresAt           DateTime?

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task              AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskRun           TaskRun?  @relation(fields: [taskRunId], references: [id], onDelete: SetNull)
  requestedByWorker AIWorker? @relation("ApprovalRequestedBy", fields: [requestedByWorkerId], references: [id])
  assignedToUser    User?     @relation("ApprovalAssignedTo", fields: [assignedToUserId], references: [id])
  decidedByUser     User?     @relation("ApprovalDecidedBy", fields: [decidedByUserId], references: [id])

  @@index([companyId, status])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Providers & models
// ---------------------------------------------------------------------------

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  LOCAL
}

enum ConnectionStatus {
  UNTESTED
  CONNECTED
  ERROR
  DISABLED
}

model ProviderConnection {
  id                   String           @id @default(cuid())
  companyId            String?
  providerType         ProviderType
  displayName          String
  encryptedCredentials String?          @db.Text
  baseUrl              String?
  organizationId       String?
  status               ConnectionStatus @default(UNTESTED)
  lastTestedAt         DateTime?
  lastError            String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  company     Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  models      ProviderModel[]
  workers     AIWorker[]
  departments Department[]
  taskRuns    TaskRun[]

  @@index([companyId])
}

model ProviderModel {
  id             String       @id @default(cuid())
  connectionId   String?
  providerType   ProviderType
  modelKey       String
  displayName    String
  contextLength  Int          @default(128000)
  inputPer1k     Decimal      @default(0) @db.Decimal(12, 6)
  outputPer1k    Decimal      @default(0) @db.Decimal(12, 6)
  effectiveFrom  DateTime     @default(now())
  supportsText   Boolean      @default(true)
  supportsImage  Boolean      @default(false)
  supportsTools  Boolean      @default(true)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  connection ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([providerType])
}

// ---------------------------------------------------------------------------
// Knowledge
// ---------------------------------------------------------------------------

enum KnowledgeStatus {
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

model KnowledgeDocument {
  id           String          @id @default(cuid())
  companyId    String
  departmentId String?
  workerId     String?
  projectId    String?
  title        String
  description  String?
  sourceType   String          @default("upload")
  fileName     String?
  mimeType     String?
  storagePath  String?
  contentText  String?         @db.Text
  status       KnowledgeStatus @default(PROCESSING)
  metadata     Json?
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation(fields: [createdById], references: [id])

  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Usage & activity & ops
// ---------------------------------------------------------------------------

model UsageRecord {
  id           String       @id @default(cuid())
  companyId    String
  departmentId String?
  projectId    String?
  workerId     String?
  taskId       String?
  taskRunId    String?
  providerType ProviderType
  model        String
  promptTokens Int          @default(0)
  completionTokens Int      @default(0)
  totalTokens  Int          @default(0)
  inputCost    Decimal      @default(0) @db.Decimal(12, 6)
  outputCost   Decimal      @default(0) @db.Decimal(12, 6)
  totalCost    Decimal      @default(0) @db.Decimal(12, 6)
  currency     String       @default("USD")
  recordedAt   DateTime     @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  worker     AIWorker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  task       AgentTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskRun    TaskRun?    @relation(fields: [taskRunId], references: [id], onDelete: SetNull)

  @@index([companyId, recordedAt])
  @@index([workerId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  workerId   String?
  entityType String
  entityId   String?
  action     String
  message    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  worker  AIWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}

model WorkerHeartbeat {
  id           String   @id @default(cuid())
  workerId     String?
  processName  String
  status       String   @default("online")
  lastSeenAt   DateTime @default(now())
  queueDepth   Int      @default(0)
  lastJobAt    DateTime?
  meta         Json?

  worker AIWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([processName])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ============================================================================
// AUTONOMOUS DELIVERY CENTER
// Additive namespace — no existing office model is modified or dropped.
// See docs/autonomous-delivery/architecture.md
// ============================================================================

enum DeliveryRole {
  OWNER
  DELIVERY_MANAGER
  DEVELOPER
  QA
  REVIEWER
  VIEWER
}

enum MissionStatus {
  DRAFT
  ANALYZING
  REQUIREMENTS_READY
  PLANNING
  EXECUTING
  REVIEWING
  TESTING
  PREVIEW_DEPLOYING
  UAT
  REVISION
  RELEASE_READY
  AWAITING_APPROVAL
  DEPLOYING
  COMPLETED
  PAUSED
  BLOCKED
  FAILED
  CANCELLED
}

enum AutonomyLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
}

enum BlockedReason {
  NONE
  BUDGET_EXCEEDED
  TIME_EXCEEDED
  MAX_ATTEMPTS
  REPEATED_FAILURE
  NO_PROGRESS
  DEADLOCK
  BLOCKED_CREDENTIALS
  PROVIDER_ERROR
  MANUAL_ESCALATION
}

enum AgentRoleKind {
  MISSION_MANAGER
  REQUIREMENT
  UX_VISUAL
  ARCHITECT
  ASSET
  FRONTEND_DEV
  BACKEND_DEV
  DATABASE
  CODE_REVIEW
  QA
  UAT
  ROOT_CAUSE
  RELEASE
}

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum WorkPackageStatus {
  BACKLOG
  READY
  ASSIGNED
  IN_PROGRESS
  IN_REVIEW
  CHANGES_REQUESTED
  TESTING
  UAT
  PASSED
  FAILED
  BLOCKED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequirementKind {
  FUNCTIONAL
  VISUAL
  NON_FUNCTIONAL
  CONSTRAINT
  OUT_OF_SCOPE
}

enum CriterionStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  WAIVED
}

enum TestKind {
  STATIC
  LINT
  TYPECHECK
  UNIT
  INTEGRATION
  E2E
  BUILD
  SECURITY
}

enum TestRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  ERROR
  SKIPPED
}

enum DefectSeverity {
  P0
  P1
  P2
  P3
}

enum DefectStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  READY_FOR_RETEST
  RETESTING
  RESOLVED
  REOPENED
  ACCEPTED
  BLOCKED
}

enum QualityGateKind {
  RQ_GATE
  ARCHITECTURE_GATE
  REVIEW_GATE
  QA_GATE
  PREVIEW_GATE
  UAT_GATE
  VISUAL_GATE
  RELEASE_GATE
}

enum GateStatus {
  PENDING
  PASSED
  FAILED
  SKIPPED
  WAIVED
}

enum ArtifactKind {
  SCREENSHOT
  TRACE
  VIDEO
  DOM_SNAPSHOT
  CONSOLE_LOG
  NETWORK_LOG
  TEST_REPORT
  DIFF_IMAGE
  GENERATED_ASSET
  REFERENCE
  LOG
}

enum DeploymentEnv {
  PREVIEW
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  PENDING
  BUILDING
  READY
  FAILED
  CANCELLED
}

model DeliveryMember {
  id        String       @id @default(cuid())
  userId    String       @unique
  role      DeliveryRole @default(VIEWER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
}

model Mission {
  id            String        @id @default(cuid())
  key           String        @unique
  title         String
  instruction   String        @db.Text
  status        MissionStatus @default(DRAFT)
  blockedReason BlockedReason @default(NONE)
  blockedDetail String?       @db.Text

  autonomyLevel AutonomyLevel @default(LEVEL_2)
  repositoryUrl String
  baseBranch    String        @default("master")
  missionBranch String?

  targetRoutes  String[]
  targetModules String[]

  visualTarget      Int @default(95)
  visualMinCategory Int @default(9)
  functionalTarget  Int @default(100)

  iteration       Int     @default(0)
  maxIterations   Int     @default(10)
  requireApproval Boolean @default(true)
  testDataPolicy  String  @default("isolated")

  createdById String?
  startedAt   DateTime?
  completedAt DateTime?
  deadlineAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy    User?                 @relation("MissionCreatedBy", fields: [createdById], references: [id])
  budget       MissionBudget?
  references   MissionReference[]
  requirements MissionRequirement[]
  workPackages WorkPackage[]
  agentRuns    AgentRun[]
  workspaces   RepositoryWorkspace[]
  testPlans    TestPlan[]
  testRuns     TestRun[]
  uatPlans     UATPlan[]
  uatRuns      UATRun[]
  checkpoints  VisualCheckpoint[]
  defects      Defect[]
  gateResults  QualityGateResult[]
  releases     ReleaseCandidate[]
  deployments  DeploymentRun[]
  usage        AgentUsageRecord[]
  auditLogs    MissionAuditLog[]
  pullRequests PullRequestRecord[]
  commits      GitCommitRecord[]
  artifacts    BrowserArtifact[]

  @@index([status])
  @@index([status, updatedAt])
  @@index([repositoryUrl, baseBranch])
  @@index([createdAt])
}

model MissionBudget {
  id                   String   @id @default(cuid())
  missionId            String   @unique
  maxCostUsd           Decimal  @default(25) @db.Decimal(12, 4)
  spentCostUsd         Decimal  @default(0) @db.Decimal(12, 4)
  maxTokens            Int      @default(5000000)
  spentTokens          Int      @default(0)
  maxDurationMin       Int      @default(480)
  maxAttemptsPerDefect Int      @default(5)
  maxIdenticalFailures Int      @default(2)
  maxParallelWriters   Int      @default(2)
  maxParallelReaders   Int      @default(4)
  updatedAt            DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model MissionReference {
  id         String   @id @default(cuid())
  missionId  String
  label      String
  storageKey String
  mimeType   String?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
}

model MissionRequirement {
  id          String          @id @default(cuid())
  missionId   String
  key         String
  kind        RequirementKind @default(FUNCTIONAL)
  title       String
  description String          @db.Text
  userStory   String?         @db.Text
  rationale   String?         @db.Text
  ambiguity   String?         @db.Text
  priority    Int             @default(2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  mission  Mission               @relation(fields: [missionId], references: [id], onDelete: Cascade)
  criteria AcceptanceCriterion[]

  @@unique([missionId, key])
  @@index([missionId, kind])
}

model AcceptanceCriterion {
  id            String          @id @default(cuid())
  requirementId String
  key           String
  statement     String          @db.Text
  measurement   String          @db.Text
  status        CriterionStatus @default(PENDING)
  required      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  requirement  MissionRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  traces       RequirementTrace[]
  defects      Defect[]
  uatSteps     UATStep[]
  workPackages WorkPackage[]

  @@unique([requirementId, key])
  @@index([status])
}

model RequirementTrace {
  id            String   @id @default(cuid())
  criterionId   String
  workPackageId String?
  commitId      String?
  testResultId  String?
  uatStepId     String?
  artifactId    String?
  note          String?  @db.Text
  satisfied     Boolean  @default(false)
  createdAt     DateTime @default(now())

  criterion   AcceptanceCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  workPackage WorkPackage?        @relation(fields: [workPackageId], references: [id], onDelete: SetNull)

  @@index([criterionId, satisfied])
}

model WorkPackage {
  id        String            @id @default(cuid())
  missionId String
  key       String
  title     String
  objective String            @db.Text
  scope     String            @db.Text
  role      AgentRoleKind
  status    WorkPackageStatus @default(BACKLOG)
  riskLevel RiskLevel         @default(LOW)

  criterionId  String?
  targetFiles  String[]
  branch       String?
  worktreePath String?

  requiresTests    Boolean @default(true)
  requiresEvidence Boolean @default(true)
  attemptCount     Int     @default(0)
  maxAttempts      Int     @default(3)
  costUsd          Decimal @default(0) @db.Decimal(12, 4)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mission      Mission                 @relation(fields: [missionId], references: [id], onDelete: Cascade)
  criterion    AcceptanceCriterion?    @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  dependsOn    WorkPackageDependency[] @relation("Dependent")
  dependedOnBy WorkPackageDependency[] @relation("Dependency")
  runs         WorkPackageRun[]
  changes      CodeChange[]
  commits      GitCommitRecord[]
  defects      Defect[]
  agentRuns    AgentRun[]
  traces       RequirementTrace[]

  @@unique([missionId, key])
  @@index([missionId, status])
  @@index([status, updatedAt])
  @@index([role])
}

model WorkPackageDependency {
  id            String @id @default(cuid())
  workPackageId String
  dependsOnId   String

  workPackage WorkPackage @relation("Dependent", fields: [workPackageId], references: [id], onDelete: Cascade)
  dependsOn   WorkPackage @relation("Dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([workPackageId, dependsOnId])
  @@index([dependsOnId])
}

model WorkPackageRun {
  id            String            @id @default(cuid())
  workPackageId String
  attempt       Int
  status        WorkPackageStatus
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  durationMs    Int?
  summary       String?           @db.Text
  error         String?           @db.Text

  workPackage WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([workPackageId, attempt])
}

model AgentRun {
  id            String         @id @default(cuid())
  missionId     String
  workPackageId String?
  role          AgentRoleKind
  status        AgentRunStatus @default(PENDING)

  promptTemplateId String?
  promptVersion    String?
  promptHash       String?
  provider         String?
  model            String?

  inputSummary  String? @db.Text
  outputSummary String? @db.Text
  error         String? @db.Text

  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)
  totalTokens      Int     @default(0)
  costUsd          Decimal @default(0) @db.Decimal(12, 6)
  latencyMs        Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  mission     Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workPackage WorkPackage?   @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  messages    AgentMessage[]

  @@index([missionId, status])
  @@index([role, status])
  @@index([createdAt])
}

model AgentMessage {
  id         String   @id @default(cuid())
  agentRunId String
  seq        Int
  role       String
  content    String   @db.Text
  toolName   String?
  toolArgs   Json?
  createdAt  DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, seq])
}

model RepositoryWorkspace {
  id             String    @id @default(cuid())
  missionId      String
  kind           String    @default("base")
  workPackageKey String?
  path           String
  branch         String?
  headSha        String?
  clean          Boolean   @default(true)
  retainUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, path])
  @@index([missionId, kind])
}

model CodeChange {
  id            String   @id @default(cuid())
  workPackageId String
  filePath      String
  changeType    String
  linesAdded    Int      @default(0)
  linesRemoved  Int      @default(0)
  diff          String?  @db.Text
  createdAt     DateTime @default(now())

  workPackage WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([workPackageId])
}

model GitCommitRecord {
  id            String   @id @default(cuid())
  missionId     String
  workPackageId String?
  sha           String
  branch        String
  message       String   @db.Text
  authorName    String?
  filesChanged  Int      @default(0)
  pushed        Boolean  @default(false)
  createdAt     DateTime @default(now())

  mission     Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workPackage WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)

  @@unique([missionId, sha])
  @@index([branch])
}

model PullRequestRecord {
  id          String   @id @default(cuid())
  missionId   String
  number      Int
  url         String
  headBranch  String
  baseBranch  String
  state       String
  checksState String?
  merged      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, number])
  @@index([state])
}

model TestPlan {
  id        String   @id @default(cuid())
  missionId String
  name      String
  createdAt DateTime @default(now())

  mission Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  suites  TestSuite[]

  @@index([missionId])
}

model TestSuite {
  id         String   @id @default(cuid())
  testPlanId String
  name       String
  kind       TestKind
  command    String
  required   Boolean  @default(true)
  createdAt  DateTime @default(now())

  testPlan TestPlan  @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  runs     TestRun[]

  @@index([testPlanId, kind])
}

model TestRun {
  id          String        @id @default(cuid())
  missionId   String
  testSuiteId String?
  kind        TestKind
  status      TestRunStatus @default(PENDING)
  command     String
  exitCode    Int?
  passed      Int           @default(0)
  failed      Int           @default(0)
  skipped     Int           @default(0)
  durationMs  Int?
  reportKey   String?
  stdoutTail  String?       @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  mission   Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  testSuite TestSuite?   @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)
  results   TestResult[]

  @@index([missionId, status])
  @@index([kind, status])
  @@index([createdAt])
}

model TestResult {
  id         String        @id @default(cuid())
  testRunId  String
  name       String
  status     TestRunStatus
  durationMs Int?
  message    String?       @db.Text
  filePath   String?

  testRun TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@index([testRunId, status])
}

model UATPlan {
  id        String   @id @default(cuid())
  missionId String
  name      String
  createdAt DateTime @default(now())

  mission Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  steps   UATStep[]

  @@index([missionId])
}

model UATStep {
  id               String         @id @default(cuid())
  uatPlanId        String
  criterionId      String?
  seq              Int
  route            String
  actor            String         @default("owner")
  precondition     String?        @db.Text
  action           String         @db.Text
  expected         String         @db.Text
  dbAssertion      String?        @db.Text
  screenshotRegion String?
  severityOnFail   DefectSeverity @default(P1)
  required         Boolean        @default(true)

  uatPlan   UATPlan              @relation(fields: [uatPlanId], references: [id], onDelete: Cascade)
  criterion AcceptanceCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  results   UATStepResult[]

  @@unique([uatPlanId, seq])
}

model UATRun {
  id             String        @id @default(cuid())
  missionId      String
  uatPlanId      String?
  status         TestRunStatus @default(PENDING)
  previewUrl     String?
  viewport       String?
  passedSteps    Int           @default(0)
  failedSteps    Int           @default(0)
  consoleErrors  Int           @default(0)
  failedRequests Int           @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())

  mission     Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  results     UATStepResult[]
  artifacts   BrowserArtifact[]
  comparisons VisualComparison[]

  @@index([missionId, status])
  @@index([createdAt])
}

model UATStepResult {
  id         String        @id @default(cuid())
  uatRunId   String
  uatStepId  String
  status     TestRunStatus
  actual     String?       @db.Text
  durationMs Int?

  uatRun  UATRun  @relation(fields: [uatRunId], references: [id], onDelete: Cascade)
  uatStep UATStep @relation(fields: [uatStepId], references: [id], onDelete: Cascade)

  @@unique([uatRunId, uatStepId])
  @@index([status])
}

model BrowserArtifact {
  id         String       @id @default(cuid())
  missionId  String
  uatRunId   String?
  kind       ArtifactKind
  storageKey String
  label      String?
  viewport   String?
  sizeBytes  Int?
  createdAt  DateTime     @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  uatRun  UATRun? @relation(fields: [uatRunId], references: [id], onDelete: SetNull)

  @@index([missionId, kind])
}

model VisualCheckpoint {
  id           String   @id @default(cuid())
  missionId    String
  key          String
  route        String
  viewport     String
  clipRegion   String?
  referenceKey String?
  targetScore  Int      @default(95)
  required     Boolean  @default(true)
  createdAt    DateTime @default(now())

  mission     Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  comparisons VisualComparison[]

  @@unique([missionId, key, viewport])
  @@index([missionId])
}

model VisualComparison {
  id              String   @id @default(cuid())
  checkpointId    String
  uatRunId        String?
  screenshotKey   String
  referenceKey    String?
  diffKey         String?
  pixelDiffPct    Decimal  @default(0) @db.Decimal(6, 3)
  perceptualScore Decimal  @default(0) @db.Decimal(6, 3)
  overallScore    Int      @default(0)
  threshold       Int      @default(95)
  passed          Boolean  @default(false)
  categoryScores  Json?
  failedRegions   Json?
  explanation     String?  @db.Text
  createdAt       DateTime @default(now())

  checkpoint VisualCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  uatRun     UATRun?          @relation(fields: [uatRunId], references: [id], onDelete: SetNull)

  @@index([checkpointId, passed])
}

model Defect {
  id            String         @id @default(cuid())
  missionId     String
  workPackageId String?
  criterionId   String?
  key           String
  title         String
  description   String         @db.Text
  severity      DefectSeverity @default(P2)
  status        DefectStatus   @default(OPEN)
  category      String         @default("functional")

  expected       String?  @db.Text
  actual         String?  @db.Text
  reproSteps     String?  @db.Text
  suspectedFiles String[]
  rootCause      String?  @db.Text
  correctionPlan String?  @db.Text

  assignedRole     AgentRoleKind?
  assignedToId     String?
  attemptCount     Int            @default(0)
  maxAttempts      Int            @default(5)
  failureSignature String?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  mission     Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workPackage WorkPackage?         @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  criterion   AcceptanceCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  assignedTo  User?                @relation("DefectAssignedTo", fields: [assignedToId], references: [id])
  evidence    DefectEvidence[]
  comments    DefectComment[]

  @@unique([missionId, key])
  @@index([missionId, status])
  @@index([severity, status])
  @@index([failureSignature])
}

model DefectEvidence {
  id         String       @id @default(cuid())
  defectId   String
  kind       ArtifactKind
  storageKey String?
  note       String?      @db.Text
  createdAt  DateTime     @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@index([defectId])
}

model DefectComment {
  id        String         @id @default(cuid())
  defectId  String
  userId    String?
  role      AgentRoleKind?
  body      String         @db.Text
  createdAt DateTime       @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([defectId])
}

model QualityGate {
  id        String          @id @default(cuid())
  kind      QualityGateKind @unique
  name      String
  config    Json?
  enabled   Boolean         @default(true)
  updatedAt DateTime        @updatedAt

  results QualityGateResult[]
}

model QualityGateResult {
  id              String          @id @default(cuid())
  missionId       String
  gateId          String?
  kind            QualityGateKind
  status          GateStatus      @default(PENDING)
  iteration       Int             @default(0)
  checks          Json?
  blockingReasons String[]
  evaluatedAt     DateTime        @default(now())

  mission Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  gate    QualityGate? @relation(fields: [gateId], references: [id], onDelete: SetNull)

  @@index([missionId, kind])
  @@index([status])
  @@index([evaluatedAt])
}

model ReleaseCandidate {
  id                String    @id @default(cuid())
  missionId         String
  version           String
  commitSha         String?
  pullRequestNumber Int?
  summary           String?   @db.Text
  gatesSnapshot     Json?
  approved          Boolean   @default(false)
  approvedById      String?
  approvedAt        DateTime?
  approvalNote      String?   @db.Text
  createdAt         DateTime  @default(now())

  mission     Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  approvedBy  User?           @relation("ReleaseApprovedBy", fields: [approvedById], references: [id])
  deployments DeploymentRun[]

  @@unique([missionId, version])
  @@index([approved])
}

model DeploymentRun {
  id                 String           @id @default(cuid())
  missionId          String
  releaseCandidateId String?
  environment        DeploymentEnv    @default(PREVIEW)
  status             DeploymentStatus @default(PENDING)
  url                String?
  commitSha          String?
  healthy            Boolean          @default(false)
  logTail            String?          @db.Text
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())

  mission          Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  releaseCandidate ReleaseCandidate? @relation(fields: [releaseCandidateId], references: [id], onDelete: SetNull)

  @@index([missionId, environment])
  @@index([status])
}

model AgentUsageRecord {
  id               String        @id @default(cuid())
  missionId        String
  agentRunId       String?
  role             AgentRoleKind
  provider         String
  model            String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  totalTokens      Int           @default(0)
  costUsd          Decimal       @db.Decimal(12, 6)
  recordedAt       DateTime      @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, recordedAt])
  @@index([provider, model])
}

model MissionAuditLog {
  id         String         @id @default(cuid())
  missionId  String
  userId     String?
  actorRole  AgentRoleKind?
  action     String
  entityType String
  entityId   String?
  fromState  String?
  toState    String?
  reason     String?        @db.Text
  evidence   Json?
  createdAt  DateTime       @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([missionId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
}
