# =====================================================================
# AI Agent Office (Next.js full-stack) — environment template.
# Copy to apps/web/.env for local dev. Validated at startup by lib/env.ts.
# NEVER commit real secrets.
# =====================================================================
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (Prisma). Docker compose service name is `db`.
DATABASE_URL="postgresql://ai_office:ai_office@localhost:5432/ai_office?schema=public"

# Auth.js session signing secret (>=16 chars, required in production).
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-in-production"

# AES-256-GCM key for encrypting provider credentials (>=32 chars, required in prod).
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY="change-me-32-chars-minimum-000000"

# Shared secret for internal worker <-> web calls.
INTERNAL_WORKER_SECRET="change-me"

# Optional Redis for BullMQ queue. Empty = PostgreSQL fallback queue.
REDIS_URL=

# File storage (local dev).
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25
LOG_LEVEL=info

# Optional provider bootstrap keys. UI-entered keys are encrypted in the DB;
# these are only used to pre-seed a system connection if desired.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
